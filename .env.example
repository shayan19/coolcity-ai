# Server-only credential. Never prefix this variable with NEXT_PUBLIC_.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Comma-separated browser origins allowed to call the FastAPI service.
# Add the deployed frontend origin here when hosting the two services separately.
COOLCITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public backend URL embedded in the frontend build. This is not a credential.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
